# Cloudflare Pages: never let the browser hold on to a stale shell.
# The game lives entirely in index.html, so only these must stay fresh.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache
